{
    "configurations": [
        {
            "name": "Launch PoleServer",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "args": [
                "start",
                "-c",
                "./test/data/bootstrap/pole-server.yaml"
            ],
            "env": {
                "MYSQL_USER": "root",
                "MYSQL_PWD": "12345678",
                "MYSQL_HOST": "127.0.0.1:3306",
            }
        },
        {
            "name": "Launch Test",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "env": {
                // 下面配置为针对 HeartBeat Benchmark 的压测环境变量
                "RUN_MODE": "ALL",
                "SERVER_IP": "127.0.0.1",
                "PORT_NUM": "200",
            }
        }
    ]
}